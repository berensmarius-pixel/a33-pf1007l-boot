# a33: replace the boot image (eMMC p6) with @FILE@, guarded. Template: build-write.sh fills in the
# @...@ values and compiles it to a33.scr. Runs from our SD-booted U-Boot (no screen or console);
# results go to @STATUS@ on the card. The ONLY eMMC write is the one "mmc write" below.
#
# Guards, in order. Each failure stops before the write, except the last (after it, see docs/allwinner-a33-sdcard-adb-wifi.md):
#   1. the image file on the card has exactly the expected size and SHA-256 (hashed in RAM)
#   2. p6 on the eMMC (sector 0x2a000, 0x7934 sectors) hashes to the expected CURRENT contents
#      (@OLD_NAME@), so a different unit or an unexpected state is never written over
#   3. if p6 already hashes to the new image, nothing is written
#   4. after the write, p6 is read back and must match the image by SHA-256 and byte compare
# mmc 0 = SD slot, mmc 1 = eMMC (MMC2). U-Boot numbers are hex.

setenv a 0x48000000
setenv b 0x4c000000
setenv e 0x47000000
setenv bytes 0x@SIZE_HEX@
setenv secs 0x@SECTORS_HEX@
setenv start 0x2a000
setenv sha_new @SHA_NEW@
setenv sha_old @SHA_OLD@
setenv a33_stage started
setenv result none
env export -t ${e}
fatwrite mmc 0:1 ${e} @STATUS@ ${filesize}

if fatload mmc 0:1 ${a} @FILE@; then
  if test "${filesize}" = "@SIZE_HEX@"; then
    hash sha256 ${a} ${bytes} h_file
    if test "${h_file}" = "${sha_new}"; then
      setenv a33_stage file_ok
      mmc dev 1
      if mmc read ${b} ${start} ${secs}; then
        hash sha256 ${b} ${bytes} h_before
        env export -t ${e}
        fatwrite mmc 0:1 ${e} @STATUS@ ${filesize}
        if test "${h_before}" = "${sha_new}"; then
          setenv result ALREADY_APPLIED_NO_WRITE
        else
          if test "${h_before}" = "${sha_old}"; then
            setenv a33_stage writing
            env export -t ${e}
            fatwrite mmc 0:1 ${e} @STATUS@ ${filesize}
            mmc dev 1
            if mmc write ${a} ${start} ${secs}; then
              setenv a33_stage written
              mmc dev 1
              if mmc read ${b} ${start} ${secs}; then
                hash sha256 ${b} ${bytes} h_after
                if test "${h_after}" = "${sha_new}"; then
                  if cmp.b ${a} ${b} ${bytes}; then
                    setenv result OK_WRITTEN_AND_VERIFIED
                  else
                    setenv result FAIL_VERIFY_COMPARE
                  fi
                else
                  setenv result FAIL_VERIFY_HASH
                fi
              else
                setenv result FAIL_READBACK
              fi
            else
              setenv result FAIL_MMC_WRITE
            fi
          else
            setenv result REFUSED_P6_NOT_EXPECTED_CONTENT
          fi
        fi
      else
        setenv result FAIL_READ_P6
      fi
    else
      setenv result REFUSED_FILE_HASH
    fi
  else
    setenv result REFUSED_FILE_SIZE
  fi
else
  setenv result FAIL_FATLOAD
fi

setenv a33_stage finished
env export -t ${e}
fatwrite mmc 0:1 ${e} @STATUS@ ${filesize}
